{
  "formatVersion": 1,
  "name": "agent-starter",
  "version": "0.1.0",
  "description": "A curated catalog and installer for a multi-harness engineering system for coding agents",
  "owner": {
    "name": "Lalit Kapoor",
    "email": "lalitkapoor@gmail.com",
    "homepage": "https://github.com/lalitkapoor"
  },
  "repository": "https://github.com/lalitkapoor/agent-starter",
  "plugins": [
    {
      "name": "agent-engineering-system",
      "version": "0.2.0",
      "description": "Maintained engineering quality, semantic architecture, and technical communication skills",
      "ownership": "maintained",
      "category": "Engineering",
      "path": "./plugins/agent-engineering-system",
      "runtimes": {
        "claude": {
          "kind": "plugin",
          "source": "local"
        },
        "codex": {
          "kind": "plugin",
          "source": "local"
        },
        "cursor": {
          "kind": "plugin",
          "source": "local"
        }
      }
    },
    {
      "name": "pstack",
      "description": "A structured engineering workflow for planning, TDD, verification, review, and proof",
      "ownership": "upstream",
      "category": "Workflow",
      "provenance": {
        "repository": "https://github.com/michael-denyer/pstack-claude",
        "ref": "main"
      },
      "runtimes": {
        "claude": {
          "kind": "plugin",
          "source": {
            "source": "git-subdir",
            "url": "https://github.com/michael-denyer/pstack-claude.git",
            "path": "plugins/pstack",
            "ref": "main"
          }
        },
        "codex": {
          "kind": "plugin",
          "source": {
            "source": "git-subdir",
            "url": "https://github.com/michael-denyer/pstack-claude.git",
            "path": "plugins/pstack",
            "ref": "main"
          }
        },
        "cursor": {
          "kind": "plugin",
          "source": {
            "source": "git-subdir",
            "url": "https://github.com/cursor/plugins.git",
            "path": "pstack",
            "ref": "main"
          }
        }
      }
    },
    {
      "name": "show-me",
      "description": "Explain the current topic with concise diagrams, code-shape sketches, and focused HTML artifacts",
      "ownership": "upstream",
      "category": "Visualization",
      "provenance": {
        "repository": "https://github.com/humanlayer/skills",
        "ref": "main"
      },
      "runtimes": {
        "claude": {
          "kind": "plugin",
          "source": {
            "source": "git-subdir",
            "url": "https://github.com/humanlayer/skills.git",
            "path": "plugins/show-me",
            "ref": "main"
          }
        },
        "codex": {
          "kind": "skills",
          "source": "humanlayer/skills",
          "agent": "codex",
          "skills": ["show-me"]
        },
        "cursor": {
          "kind": "skills",
          "source": "humanlayer/skills",
          "agent": "cursor",
          "skills": ["show-me"]
        }
      }
    },
    {
      "name": "mattpocock-skills",
      "description": "Upstream specialist skills for research, review, design, debugging, and engineering handoffs",
      "ownership": "upstream",
      "category": "Specialist skills",
      "provenance": {
        "repository": "https://github.com/mattpocock/skills",
        "ref": "main"
      },
      "runtimes": {
        "claude": {
          "kind": "plugin",
          "source": {
            "source": "github",
            "repo": "mattpocock/skills",
            "ref": "main"
          }
        },
        "codex": {
          "kind": "skills",
          "source": "mattpocock/skills",
          "agent": "codex",
          "skills": [
            "codebase-design",
            "domain-modeling",
            "diagnosing-bugs",
            "research",
            "improve-codebase-architecture",
            "code-review",
            "prototype",
            "writing-for-agents",
            "handoff"
          ]
        },
        "cursor": {
          "kind": "skills",
          "source": "mattpocock/skills",
          "agent": "cursor",
          "skills": [
            "codebase-design",
            "domain-modeling",
            "diagnosing-bugs",
            "research",
            "improve-codebase-architecture",
            "code-review",
            "prototype",
            "writing-for-agents",
            "handoff"
          ]
        }
      }
    }
  ]
}
